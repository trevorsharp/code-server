{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "enabled_providers": [
    "openai",
    "claude-cli",
    "github-copilot"
  ],
  "provider": {
    "openai": {
      "whitelist": [
        "gpt-5.6-sol",
        "gpt-5.6-luna",
        "gpt-6-astra"
      ]
    },
    "claude-cli": {
      "whitelist": [
        "claude-fable-5-1",
        "claude-opus-5"
      ]
    },
    "github-copilot": {
      "whitelist": [
        "gpt-5.6-sol",
        "gpt-5.6-luna",
        "gpt-6-astra",
        "claude-opus-5",
        "gemini-3.8-flash"
      ]
    }
  },
  "model": "openai/gpt-5.6-sol",
  "agent": {
    "title": {
      "model": "openai/gpt-5.6-luna"
    }
  },
  "formatter": {
    "csharpier": {
      "command": [
        "csharpier",
        "format",
        "$FILE"
      ],
      "extensions": [
        ".cs",
        ".csproj",
        ".slnx"
      ]
    }
  },
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "cors": [
      "http://localhost:4096",
      "https://work.trs.dev"
    ]
  },
  "permission": {
    "*": "allow"
  },
  "mcp": {
    "Jira": {
      "type": "remote",
      "url": "https://jira-mcp.cvnacorp.com/mcp",
      "enabled": false
    },
    "Google Workspace": {
      "type": "remote",
      "url": "https://gdrive-mcp.cvnacorp.com/mcp",
      "enabled": false
    },
    "Slack": {
      "type": "remote",
      "url": "https://slack-mcp.cvnacorp.com/mcp",
      "enabled": false
    },
    "Snowflake": {
      "type": "remote",
      "url": "https://snowflake-mcp.cvnacorp.com/mcp",
      "timeout": 240000,
      "enabled": false
    },
    "Splunk": {
      "type": "remote",
      "url": "https://splunk-mcp.cvnacorp.com/mcp",
      "enabled": false
    },
    "Fastlane": {
      "type": "remote",
      "url": "https://fastlane-mcp.cvnacorp.com/mcp",
      "enabled": false
    },
    "Carvana Publish": {
      "type": "remote",
      "url": "https://publish-mcp.cvnacorp.com/mcp",
      "enabled": false
    },
    "Datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/v1/mcp",
      "enabled": false
    },
    "Chrome DevTools": {
      "type": "local",
      "command": [
        "bun",
        "/home/sharp/.config/opencode/mcp/chrome-devtools.ts"
      ],
      "environment": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1",
        "CHROME_DEVTOOLS_EXTENSIONS": "[]"
      },
      "enabled": false
    }
  }
}